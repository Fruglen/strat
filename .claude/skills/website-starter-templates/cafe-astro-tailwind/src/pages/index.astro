---
import Layout from "../layouts/Layout.astro";
import MenuCard from "../components/MenuCard.astro";

const menuItems = [
	{
		title: "Iced Coffee Palm Sugar",
		description:
			"Kopi susu signature dengan gula aren asli dan krimer rahasia yang creamy.",
		price: "Rp 25.000",
		image: "/images/iced_coffee.png",
	},
	{
		title: "Hot Cappuccino",
		description:
			"Espresso base dengan susu yang di-steam sempurna dan busa lembut di atasnya.",
		price: "Rp 28.000",
		image: "https://images.unsplash.com/photo-1572442388796-11668a67e53d?q=80&w=800&auto=format&fit=crop",
	},
	{
		title: "Manual Brew V60",
		description:
			"Pilihan biji kopi single origin yang diseduh manual untuk rasa yang lebih clean.",
		price: "Rp 32.000",
		image: "/images/manual_brew.png",
	},
];

const testimonials = [
	{
		name: "Budi Santoso",
		role: "Coffee Enthusiast",
		comment:
			"Tempat paling nyaman buat WFC! Kopi Gula Arennya bener-bener nagih dan gak bikin neg.",
		avatar: "https://i.pravatar.cc/150?u=budi",
	},
	{
		name: "Siska Amelia",
		role: "Freelancer",
		comment:
			"Suka banget sama vibe interiornya yang minimalist. Cappuccino-nya smooth banget!",
		avatar: "https://i.pravatar.cc/150?u=siska",
	},
];
---

<Layout title="Beranda">
	<!-- Navigation -->
	<nav class="fixed w-full z-50 px-6 py-4">
		<div
			class="max-w-7xl mx-auto flex justify-between items-center glass rounded-full px-8 py-3"
		>
			<a
				href="#"
				class="text-2xl font-bold text-[#8B5E3C] font-['Outfit'] tracking-tight"
				>Ruang Temu.</a
			>
			<div class="hidden md:flex space-x-8">
				<a
					href="#hero"
					class="text-sm font-medium hover:text-[#8B5E3C] transition-colors"
					>Beranda</a
				>
				<a
					href="#menu"
					class="text-sm font-medium hover:text-[#8B5E3C] transition-colors"
					>Menu</a
				>
				<a
					href="#vibe"
					class="text-sm font-medium hover:text-[#8B5E3C] transition-colors"
					>Vibe</a
				>
			</div>
			<a
				href="https://wa.me/628123456789"
				class="bg-[#8B5E3C] text-white px-6 py-2 rounded-full text-sm font-medium hover:bg-[#2C1E12] transition-all duration-300"
			>
				Hubungi Kami
			</a>
		</div>
	</nav>

	<main>
		<!-- Hero Section -->
		<section
			id="hero"
			class="relative min-h-screen flex items-center pt-20 overflow-hidden"
		>
			<div class="absolute inset-0 z-0">
				<img
					src="/images/hero_cafe.png"
					alt="Cafe Interior"
					class="w-full h-full object-cover"
				/>
				<div
					class="absolute inset-0 bg-gradient-to-r from-[#FAF7F2] via-[#FAF7F2]/80 to-transparent"
				>
				</div>
			</div>

			<div class="container mx-auto px-6 relative z-10">
				<div class="max-w-2xl">
					<span
						class="inline-block bg-[#8B5E3C]/10 text-[#8B5E3C] px-4 py-1 rounded-full text-sm font-semibold mb-6 animate-fade-in"
					>
						Open Daily 08:00 - 22:00
					</span>
					<h1
						class="text-5xl md:text-7xl font-bold text-[#2C1E12] mb-6 leading-[1.1]"
					>
						Temukan <span class="text-[#8B5E3C]">Kenyamanan</span> dalam
						Setiap Sesapan.
					</h1>
					<p
						class="text-lg text-stone-600 mb-10 leading-relaxed max-w-lg"
					>
						Nikmati kopi pilihan dengan biji kopi premium dan
						suasana hangat yang dirancang khusus untuk inspirasi dan
						obrolan Anda.
					</p>
					<div class="flex flex-col sm:flex-row gap-4">
						<a
							href="#menu"
							class="bg-[#8B5E3C] text-white px-8 py-4 rounded-full font-bold text-center hover:bg-[#2C1E12] transition-all duration-300 transform hover:scale-105"
						>
							Lihat Menu Kami
						</a>
						<a
							href="https://wa.me/628123456789"
							class="glass px-8 py-4 rounded-full font-bold text-center hover:bg-white transition-all duration-300"
						>
							Order via WhatsApp
						</a>
					</div>
				</div>
			</div>
		</section>

		<!-- Signature Menu Section -->
		<section id="menu" class="py-24 bg-white">
			<div class="container mx-auto px-6">
				<div class="text-center max-w-3xl mx-auto mb-16">
					<h2
						class="text-4xl md:text-5xl font-bold text-[#2C1E12] mb-4"
					>
						Menu Signature
					</h2>
					<p class="text-stone-500">
						Dikurasi dengan teliti untuk menghadirkan cita rasa kopi
						yang tak terlupakan.
					</p>
				</div>

				<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
					{menuItems.map((item) => <MenuCard {...item} />)}
				</div>
			</div>
		</section>

		<!-- Testimonials/Vibe Section -->
		<section id="vibe" class="py-24 bg-[#FAF7F2]">
			<div class="container mx-auto px-6">
				<div class="flex flex-col md:flex-row items-center gap-16">
					<div class="w-full md:w-1/2">
						<h2
							class="text-4xl md:text-5xl font-bold text-[#2C1E12] mb-8"
						>
							Apa Kata <br /><span class="text-[#8B5E3C]"
								>Kawan Temu</span
							> Kami?
						</h2>
						<div class="space-y-6">
							{
								testimonials.map((t) => (
									<div class="bg-white p-8 rounded-3xl shadow-sm border border-stone-100 hover:shadow-md transition-shadow">
										<p class="text-stone-600 italic mb-6">
											"{t.comment}"
										</p>
										<div class="flex items-center gap-4">
											<img
												src={t.avatar}
												alt={t.name}
												class="w-12 h-12 rounded-full object-cover"
											/>
											<div>
												<h4 class="font-bold text-[#2C1E12]">
													{t.name}
												</h4>
												<p class="text-sm text-stone-400">
													{t.role}
												</p>
											</div>
										</div>
									</div>
								))
							}
						</div>
					</div>
					<div class="w-full md:w-1/2 grid grid-cols-2 gap-4">
						<div class="space-y-4">
							<img
								src="https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?q=80&w=600&auto=format&fit=crop"
								class="rounded-3xl w-full aspect-[3/4] object-cover"
								alt="Cafe Vibe 1"
							/>
							<div
								class="bg-[#8B5E3C] rounded-3xl aspect-square flex items-center justify-center p-8 text-white text-center"
							>
								<p class="font-bold text-xl italic">
									"Best place to recharge your energy."
								</p>
							</div>
						</div>
						<div class="space-y-4 pt-8">
							<img
								src="https://images.unsplash.com/photo-1501339847302-ac426a4a7cbb?q=80&w=600&auto=format&fit=crop"
								class="rounded-3xl w-full aspect-square object-cover"
								alt="Cafe Vibe 2"
							/>
							<img
								src="/images/iced_coffee.png"
								class="rounded-3xl w-full aspect-[3/4] object-cover"
								alt="Cafe Vibe 3"
							/>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Footer -->
		<footer class="bg-[#2C1E12] text-white py-12">
			<div class="container mx-auto px-6 text-center">
				<h3 class="text-3xl font-bold mb-4 font-['Outfit']">
					Ruang Temu.
				</h3>
				<p class="text-stone-400 mb-8">
					Jl. Kopi Nikmat No. 123, Jakarta Selatan
				</p>
				<div class="flex justify-center space-x-6 mb-8">
					<a href="#" class="hover:text-[#D4A373]">Instagram</a>
					<a href="#" class="hover:text-[#D4A373]">Facebook</a>
					<a href="#" class="hover:text-[#D4A373]">TikTok</a>
				</div>
				<div
					class="border-t border-white/10 pt-8 text-sm text-stone-500"
				>
					&copy; 2025 Kopi Ruang Temu. All rights reserved.
				</div>
			</div>
		</footer>
	</main>
</Layout>

<style>
	@keyframes fade-in {
		from {
			opacity: 0;
			transform: translateY(20px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	.animate-fade-in {
		animation: fade-in 1s ease-out forwards;
	}
</style>
